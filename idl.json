{
  "name": "private_airdrop",
  "version": "0.1.0",
  "instructions": [
    {
      "name": "initialize",
      "accounts": [
        { "name": "distribution", "isMut": true, "isSigner": false, "pda": { "seeds": [{ "kind": "literal", "value": "distribution_state" }] } },
        { "name": "authority", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "merkle_root", "type": { "array": ["u8", 32] } },
        { "name": "total_supply", "type": "u128" }
      ]
    },
    {
      "name": "claim",
      "accounts": [
        { "name": "distribution", "isMut": true, "isSigner": false, "pda": { "seeds": [{ "kind": "literal", "value": "distribution_state" }] } }
      ],
      "args": [
        { "name": "receipt_bytes", "type": "bytes" },
        { "name": "recipient_note", "type": "bytes" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "DistributionState",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "merkle_root", "type": { "array": ["u8", 32] } },
          { "name": "total_supply", "type": "u128" },
          { "name": "claimed", "type": "u128" },
          { "name": "spent_nullifiers", "type": { "vec": { "array": ["u8", 32] } } }
        ]
      }
    }
  ],
  "errors": [
    { "code": 7001, "name": "ProofInvalid" },
    { "code": 7002, "name": "DistributorMismatch" },
    { "code": 7003, "name": "RootMismatch" },
    { "code": 7004, "name": "NullifierSpent" },
    { "code": 7005, "name": "DistributionExhausted" },
    { "code": 7006, "name": "RecipientMismatch" }
  ]
}
